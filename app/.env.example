# TAASCOR recruitment core configuration
# Copy these names into your host environment. Do not commit populated secrets.

APP_ENV=local
# Production must use a credential-free HTTPS origin only, with no path, query, or fragment.
APP_URL=http://127.0.0.1:8080
APP_KEY=
APP_TIMEZONE=Asia/Manila
APP_DEBUG=false
PUBLIC_INDEXING_ENABLED=false
ALLOW_NON_PRODUCTION_WEB=false
TRUSTED_PROXY_HTTPS=false
# Exact proxy IPs only; leave blank unless the host confirms and strips client X-Forwarded-Proto.
TRUSTED_PROXY_IPS=

# Leave DB_DSN blank to use a temporary-directory SQLite database locally.
# Production must use MySQL with utf8mb4 after the production-like database gate passes.
# Example: mysql:host=127.0.0.1;port=3306;dbname=taascor;charset=utf8mb4
DB_DSN=
DB_USER=
DB_PASSWORD=

SESSION_COOKIE_NAME=taascor_recruitment
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# Must be an absolute private directory outside the public document root.
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880
MAX_PRIVATE_STORAGE_BYTES=1073741824
# Keep zero until an approved retention schedule exists.
RESUME_RETENTION_DAYS=0
RESUME_UPLOAD_ENABLED=false

# Replace this draft identifier only after the DPO-approved notice is published.
PRIVACY_NOTICE_VERSION=draft-2026-09-01
PRIVACY_NOTICE_URL=/apply/privacy.php
APPLICANT_COLLECTION_ENABLED=false
WORKFORCE_PRIVACY_NOTICE_VERSION=draft-workforce-2026-09-01
WORKFORCE_PRIVACY_NOTICE_URL=/legal/privacy/
WORKFORCE_COLLECTION_ENABLED=false

# Production feature gates. Applicant/workforce collection, resume upload, and
# staff workflows are also code-locked until a reviewed release implements and
# records their external security, legal, identity, routing, and lifecycle gates.
# Environment flags alone cannot activate those capabilities in production.
STAFF_WORKFLOWS_ENABLED=false
JOB_PUBLICATION_ENABLED=false

# Used only by scripts/create_staff.php. Never commit populated values.
STAFF_SEED_NAME=
STAFF_SEED_EMAIL=
STAFF_SEED_PASSWORD=
