{
  "name": "taascor-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local verification harness for the TAASCOR public experience and recruitment portal.",
  "scripts": {
    "test": "npm run test:static && npm run test:e2e",
    "test:static": "node --test --test-concurrency=1 tests/static/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.mjs",
    "qa": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
