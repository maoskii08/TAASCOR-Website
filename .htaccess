Options -Indexes
DirectoryIndex index.php index.html

RewriteEngine On
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^index\.html$ index.php [L]
RewriteRule ^jobs/?$ careers/index.php [L,QSA]
RewriteRule ^jobs/([a-z0-9][a-z0-9-]{0,159})/?$ careers/job.php [L]
RewriteRule ^apply/([a-z0-9][a-z0-9-]{0,159})/?$ apply/index.php [L]
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^(?:\.git|\.claude|app|database|storage|Backups|Planning|Audit|docs|tests|scripts|node_modules|vendor)(?:/|$) - [R=404,L,NC]

<FilesMatch "(^\.|~$|^(?:composer|package)(?:-lock)?\.(?:json|lock)$|^(?:playwright|vite|webpack|rollup|eslint|prettier)\.config\.[^.]+$|\.(?:sql|md|lock|toml|log|ini|example|zip|tar|gz|tgz|bz2|7z|rar|bak|old|orig|swp)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always unset X-Powered-By
</IfModule>

ErrorDocument 404 /site/404.php
